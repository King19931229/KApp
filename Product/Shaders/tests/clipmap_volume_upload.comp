layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;
layout(std430, binding = 0) readonly buffer Input { vec4 values[]; } inputData;
#ifdef CLIPMAP_SCREEN
#define CLIPMAP_IMAGE image2D
#else
#define CLIPMAP_IMAGE image3D
#endif
#ifdef CLIPMAP_UNORM
layout(binding = 1, rgba8) uniform writeonly CLIPMAP_IMAGE target;
#else
layout(binding = 1, rgba16f) uniform writeonly CLIPMAP_IMAGE target;
#endif
void main()
{
	ivec3 pos = ivec3(gl_GlobalInvocationID);
#ifdef CLIPMAP_SCREEN
	ivec3 size = ivec3(imageSize(target), 1);
#else
	ivec3 size = imageSize(target);
#endif
	if (any(greaterThanEqual(pos, size))) return;
	uint index = uint((pos.z * size.y + pos.y) * size.x + pos.x);
#ifdef CLIPMAP_SCREEN
	imageStore(target, pos.xy, inputData.values[index]);
#else
	imageStore(target, pos, inputData.values[index]);
#endif
}
