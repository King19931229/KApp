#include "voxel/svo/octree/octree_common.h"
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(binding = 1) buffer Nodes { uint uOctree[]; };
layout(binding = 2) buffer Data { uvec4 uOctreeData[]; };
layout(binding = 3) buffer MipData { uint uOctreeMipmapData[][6]; };
layout(binding = 4) writeonly buffer Results { uvec4 results[]; };
#include "voxel/svo/octree/octree_util.h"
void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= 64u) return;
	uvec3 pos = uvec3(i % 4u, (i / 4u) % 4u, i / 16u);
	uint dataIndex = 0xffffffffu;
	bool found = GetOctreeDataIndex(pos, 4u, dataIndex);
	uint nodeIndex = 0xffffffffu;
	bool nodeFound = GetOctreeNodeIndex(pos, 4u, 2u, nodeIndex);
	bool stored = false;
	if (any(notEqual(pos, uvec3(0))))
		stored = StoreOctreeRadiance(4u, ivec3(pos), vec4(1, 0, 0, 1));
	results[i] = uvec4(found ? 1u : 0u, dataIndex, nodeFound ? 1u : 0u, stored ? 1u : 0u);
}
