layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;
layout(std430, binding = 0) readonly buffer Input { vec4 values[]; } inputData;
#ifdef SVO_R8
layout(binding = 1, r8) uniform writeonly image3D target;
#else
layout(binding = 1, rgba8) uniform writeonly image3D target;
#endif
void main()
{
	ivec3 pos = ivec3(gl_GlobalInvocationID);
	ivec3 size = imageSize(target);
	if (any(greaterThanEqual(pos, size))) return;
	uint index = uint((pos.z * size.y + pos.y) * size.x + pos.x);
	imageStore(target, pos, inputData.values[index]);
}
