layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;
#ifdef SVO_SCREEN
layout(binding = 0) uniform sampler2D source;
#else
layout(binding = 0) uniform sampler3D source;
#endif
layout(std430, binding = 1) writeonly buffer Output { vec4 values[]; } outputData;
#ifndef SVO_MIP
#define SVO_MIP 0
#endif
void main()
{
	ivec3 pos = ivec3(gl_GlobalInvocationID);
#ifdef SVO_SCREEN
	ivec3 size = ivec3(textureSize(source, SVO_MIP), 1);
#else
	ivec3 size = textureSize(source, SVO_MIP);
#endif
	if (any(greaterThanEqual(pos, size))) return;
	uint index = uint((pos.z * size.y + pos.y) * size.x + pos.x);
#ifdef SVO_SCREEN
	outputData.values[index] = texelFetch(source, pos.xy, SVO_MIP);
#else
	outputData.values[index] = texelFetch(source, pos, SVO_MIP);
#endif
}
