#include "public.h"
#include "voxel/clipmap/voxel_clipmap_common.h"
#include "voxel/clipmap/lighting/downsample_common.h"

layout(local_size_x = VOXEL_CLIPMAP_GROUP_SIZE, local_size_y = VOXEL_CLIPMAP_GROUP_SIZE, local_size_z = VOXEL_CLIPMAP_GROUP_SIZE) in;
layout(binding = VOXEL_CLIPMAP_BINDING_VISIBILITY, rgba8) uniform image3D voxelVisibility;
layout(binding = BINDING_OBJECT) uniform Object_DYN_UNIFORM
{
	uint level;
} object;

void main()
{
	if (any(greaterThanEqual(gl_GlobalInvocationID, uvec3(volumeDimension))) || object.level == 0 || object.level >= levelCount)
		return;
	ivec3 writePos, childPos;
	float lerpFactor;
	bool covered = DownsamplePosition(object.level, writePos, childPos, lerpFactor);
	for (uint face = 0; face < 6; ++face)
	{
		ivec3 facePos = writePos + GetFaceOffset(face);
		vec4 value = imageLoad(voxelVisibility, facePos);
		value.a = value.r;
		if (covered)
		{
			vec4 children[8];
			for (int i = 0; i < 8; ++i)
				children[i] = imageLoad(voxelVisibility, DownsampleChildCoord(childPos, object.level, face, i));
			vec4 filtered = CompositeDownsampleFace(children, face);
			value.a = mix(filtered.a, value.r, lerpFactor);
		}
		value.g = value.a;
		imageStore(voxelVisibility, facePos, value);
	}
}