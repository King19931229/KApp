#include "public.h"
#include "voxel/clipmap/voxel_clipmap_common.h"

layout(local_size_x = VOXEL_CLIPMAP_GROUP_SIZE, local_size_y = VOXEL_CLIPMAP_GROUP_SIZE, local_size_z = VOXEL_CLIPMAP_GROUP_SIZE) in;
layout(binding = VOXEL_CLIPMAP_BINDING_RADIANCE, rgba16f) uniform readonly image3D voxelRadiance;
layout(binding = VOXEL_CLIPMAP_BINDING_RADIANCE2, rgba16f) uniform writeonly image3D voxelRadianceSource;
layout(binding = BINDING_OBJECT) uniform Object_DYN_UNIFORM
{
	uint level;
} object;

void main()
{
	if (any(greaterThanEqual(gl_GlobalInvocationID, uvec3(volumeDimension))))
		return;
	ivec3 pos = ivec3(gl_GlobalInvocationID) + ivec3(borderSize);
	pos.y += int((volumeDimension + 2 * borderSize) * object.level);
	for (uint face = 0; face < 6; ++face)
	{
		ivec3 facePos = pos + GetFaceOffset(face);
		imageStore(voxelRadianceSource, facePos, imageLoad(voxelRadiance, facePos));
	}
}
